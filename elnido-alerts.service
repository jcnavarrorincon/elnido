[Unit]
Description=El Nido Alert Scheduler
After=network.target elnido.service

[Service]
Type=oneshot
User=openclaw
Environment=HOME=/home/openclaw
Environment=XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=/home/openclaw/.openclaw/elnido.env
WorkingDirectory=/home/openclaw/elnido
ExecStart=/usr/bin/node /home/openclaw/elnido/scheduler.js

[Install]
WantedBy=multi-user.target
