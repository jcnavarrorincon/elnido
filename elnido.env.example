# El Nido - Configuración de Email
# Copiar a /home/openclaw/.openclaw/elnido.env y ajustar valores

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password
FROM_EMAIL=tu-email@gmail.com

# El Nido URL (para API calls)
ELNIDO_URL=http://localhost:3344
